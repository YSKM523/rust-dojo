{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rust-dojo",
  "main": "worker-entry.mjs",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-v4-pro"
  },
  "kv_namespaces": [
    { "binding": "AI_RATELIMIT", "id": "7f3db3d89431422ea3a8068bef7c4fbd" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rust-dojo",
      "database_id": "39bf19ae-6f2b-4ab9-8a91-20a2839fd8e5"
    }
  ],
  "services": [
    { "binding": "MAIL", "service": "lakebbs-mail" },
    { "binding": "API", "service": "rust-dojo-api" }
  ]
}
