{
  "name": "rust-dojo",
  "version": "0.1.0",
  "private": true,
  "description": "调用 Rust Playground 真实编译运行的中文 Rust 后端实战学习平台",
  "author": "YSKM523",
  "license": "MIT",
  "scripts": {
    "dev": "cd workers/api && wrangler dev --env-file ../../.dev.vars",
    "lint": "eslint .",
    "test": "vitest run",
    "assets": "node scripts/build-site-assets.mjs",
    "test:watch": "vitest",
    "test:soundness": "PLAYGROUND_TESTS=1 vitest run content/soundness.test.ts",
    "deploy": "npm run assets && cd workers/api && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  }
}
